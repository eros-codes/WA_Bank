<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mycheckbooks" prefHeight="700.0" prefWidth="900.0" styleClass="anchorpane" stylesheets="@login.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.customer.MyChequesController">
   <children>
      <ScrollPane fx:id="scrolchecks" layoutX="21.0" layoutY="179.0" prefHeight="500.0" prefWidth="860.0" styleClass="scroll-bar" stylesheets="@login.css">
         <content>
            <VBox fx:id="seechecks" prefHeight="619.0" prefWidth="854.0" spacing="20.0" />
         </content>
      </ScrollPane>
      <Label layoutX="330.0" layoutY="78.0" text="my checkbooks" textFill="WHITE">
         <font>
            <Font name="AzonixRegular" size="24.0" />
         </font>
      </Label>
      <Button fx:id="addcheckbook" layoutX="335.0" layoutY="121.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="228.0" styleClass="donebtn" stylesheets="@login.css" text="add a checkbook">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button fx:id="back" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="78.0" styleClass="donebtn" stylesheets="@login.css" text="back">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
