# Copy this file to ".env" (in the folder you start the app from) and fill it in.
# .env is listed in .gitignore, so your real password is never committed.
# Any of these can also be set as an environment variable, which wins over the file.

DB_URL=jdbc:mysql://127.0.0.1:3306/userdetail
DB_USER=bank_app
DB_PASSWORD=change-me

# Optional: how many PBKDF2 rounds password hashes use (default 210000).
# PASSWORD_HASH_ITERATIONS=210000
